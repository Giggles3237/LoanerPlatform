# Advisor Task Planner — separate service from the loaner sheet.
# On Railway: new service from this repo, set RAILWAY_DOCKERFILE_PATH=Dockerfile.planner
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

COPY advisor_planner ./advisor_planner

ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT} --workers 2 --timeout 180 advisor_planner.webapp:app"]
